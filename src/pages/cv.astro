<script>
  import { formatWorkDuration } from '~/utils/work-duration'

  function updateWorkDurations(root: HTMLElement) {
    root.querySelectorAll<HTMLElement>('[data-work-duration]').forEach((element) => {
      const start = element.dataset.workStart
      if (!start) return

      element.textContent = formatWorkDuration(start, element.dataset.workEnd || null)
    })
  }

  function initCvView() {
    const root = document.querySelector<HTMLElement>('[data-cv-root]')
    if (!root) return

    updateWorkDurations(root)
    if (root.dataset.initialized === 'true') return

    root.dataset.initialized = 'true'
    const viewButtons = root.querySelectorAll<HTMLButtonElement>('[data-cv-view]')
    const viewPanels = root.querySelectorAll<HTMLElement>('[data-cv-view-panel]')

    function setView(view: 'web' | 'print', updateUrl = true) {
      root!.dataset.view = view
      viewButtons.forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.cvView === view))
      })
      viewPanels.forEach((panel) => {
        const isActive = panel.dataset.cvViewPanel === view
        panel.setAttribute('aria-hidden', String(!isActive))
        panel.inert = !isActive
      })

      if (!updateUrl) return
      const url = new URL(window.location.href)
      if (view === 'print') url.searchParams.set('view', 'print')
      else url.searchParams.delete('view')
      window.history.replaceState({}, '', url)
    }

    viewButtons.forEach((button) => {
      button.addEventListener('click', () => {
        setView(button.dataset.cvView === 'print' ? 'print' : 'web')
      })
    })

    root
      .querySelector<HTMLButtonElement>('[data-print-cv]')
      ?.addEventListener('click', () => {
        window.print()
      })

    const initialView = new URL(window.location.href).searchParams.get('view')
    setView(initialView === 'print' ? 'print' : 'web', false)
  }

  initCvView()
  document.addEventListener('astro:page-load', initCvView)
</script>


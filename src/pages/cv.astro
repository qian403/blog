    skills: ['Linux', 'Windows', 'Docker', 'Git', 'Nginx'],
  },
  {
    name: 'Network & Security',
    skills: ['BGP', '網路維運', '系統維運', '資訊安全'],
  },
]

const projects = [
  {
    name: 'AS215934 自治系統',
    description: '運營個人自治系統，實踐 BGP 路由協議與網路架構設計。',
    stack: 'BGP / Network Operations',
    href: 'https://bgp.tools/as/215934',
    linkLabel: 'BGP Tools',
  },
  {
    name: 'FutureNest Chatbot',
    description: '支援文件索引與多供應商 LLM 回退的 RAG 文件檢索聊天機器人。',
    stack: 'Django / React / Chroma / Docker',
    href: 'https://github.com/qian403/futurenest-chatbot',
    linkLabel: 'GitHub',
  },
  {
    name: 'NIU-app',
    description: '整合校務系統、Moodle、課表與行事曆的宜蘭大學校園 App。',
    stack: 'Swift / SwiftUI / UIKit / WidgetKit',
    href: 'https://github.com/qian403/NIU-app',
    linkLabel: 'GitHub',
  },
  {
    name: 'Web Tools',
    description: '以 Vue 開發的實用網頁工具集合。',
    stack: 'Vue.js',
    href: 'https://github.com/qian403/web-tools',
    linkLabel: 'GitHub',
  },
]

const vulnerabilityDisclosures = [
  {
    id: 'ZD-2026-00749',
    organization: '中天新聞網',
    title: '管理後台 API 的認證與授權機制存在缺陷',
    description:
      '管理後台 API 缺乏存取控制，未登入的攻擊者可取得 API token，並讀取逾 7,000 筆含個人資料的民眾投訴紀錄。',
    type: 'Broken Access Control · CWE-284',
    risk: '中風險',
    year: '2026',
    href: 'https://zeroday.hitcon.org/vulnerability/ZD-2026-00749',
  },
  {
    id: 'ZD-2025-01331',
    organization: '國立宜蘭大學',
    title: '投稿系統前端加密授權繞過導致論文資料未授權存取',
    description:
      '投稿系統將授權檢查與加密金鑰置於前端，攻擊者可繞過存取控制，未經授權讀取投稿論文與作者個人資料。',
    type: 'Broken Access Control · CWE-284',
    risk: '高風險',
    year: '2025',
    href: 'https://zeroday.hitcon.org/vulnerability/ZD-2025-01331',
  },
]

const leadership = [
  {
    name: 'SITCON 學生計算機年會 2026',
    role: '總召',
    year: '2026',
    href: 'https://sitcon.org/2026/',
  },
  {
    name: 'SITCON Camp 2025',
    role: '副召',
    year: '2025',
    href: 'https://sitcon.camp/2025/',
  },
  {
    name: 'SITCON 學生計算機年會 2025',
    role: '行政組副組長',
    year: '2025',
    href: 'https://sitcon.org/2025/',
  },
  {
    name: 'SITCON 學生計算機年會 2024',
    role: '場務組志工',
    year: '2024',
    href: 'https://sitcon.org/2024/',
  },
]

const additionalExperience = [
  { name: 'AWS STEM Summer Camp on The Cloud', role: '學員', year: '2023' },
  { name: '教育部先進資通安全實務人才培育計畫', role: '學員', year: '2023' },
  { name: '一日資安體驗營', role: '助教', year: '2023' },
  { name: 'AIS3 Junior', role: '學員', year: '2022' },
  { name: '羅東高工資訊研究社', role: '副社長', year: '2021-2023' },
]

function formatDate(date: string | null): string {
  if (!date) return 'Present'
  const [year, month] = date.split('-')
  return month ? `${year}.${month}` : year
}
---

<Layout
  title="CHIEN 履歷"
  description="CHIEN 的履歷，整理資訊工程背景、實習經歷、資訊安全、網路技術、BGP 與系統維運相關能力。"
  pageType="profile"
  wide
>
  <div class="cv-root" data-cv-root data-view="web">
    <div class="cv-toolbar py-5 sm:py-7" data-scroll-aware-header>
      <div class="flex min-w-0 items-center justify-between gap-4">
        <div class="min-w-0">
          <p class="font-mono text-xs font-semibold uppercase text-accent">
            Curriculum Vitae
          </p>
          <p class="mt-1 text-xs text-foreground/55">Last updated / 2026.07</p>
        </div>

        <div class="flex shrink-0 items-center gap-2 sm:gap-3">
          <div class="cv-view-switch" role="group" aria-label="履歷顯示模式">
            <button type="button" data-cv-view="web" aria-pressed="true">網頁版</button>
            <button type="button" data-cv-view="print" aria-pressed="false">
              列印預覽
            </button>
          </div>
          <button type="button" data-print-cv class="cv-print-button">
            <span class="hidden sm:inline">列印 / </span>PDF
          </button>
        </div>
      </div>
    </div>

    <article class="cv-web-view cv-classic" data-cv-view-panel="web">
      <header
        class="cv-web-hero grid gap-10 border-b border-foreground/10 py-10 sm:py-14 lg:grid-cols-[minmax(0,1fr)_15rem] lg:items-end"
      >
        <div class="max-w-3xl">
          <p class="mb-5 font-mono text-xs font-semibold uppercase text-accent">
            Network · Security · Systems
          </p>
          <h1 class="text-5xl font-bold leading-none text-foreground sm:text-7xl">
            徐嘉謙 <span
              class="mt-3 block text-xl font-semibold text-foreground/48 sm:text-2xl"
              >CHIEN</span
            >
          </h1>
          <p class="mt-7 max-w-2xl text-xl/8 font-semibold text-foreground sm:text-2xl/9">
            在網路、資安與系統維運之間，把複雜問題整理成可靠、可持續維護的實作。
          </p>
          <p class="mt-5 max-w-2xl text-base/7 text-foreground/68 sm:text-lg/8">
            資訊工程學生，具備企業系統維運、網路管理、資訊安全與全端開發實務經驗。運營個人自治系統
            AS215934，持續投入 BGP 路由、可靠系統與資安領域。
          </p>
          <nav
            class="cv-contact-links mt-7 flex items-center gap-2"
            aria-label="聯絡方式"
          >
            <a
              href="mailto:hi@chien.dev"
              class="cv-contact-link"
              aria-label="Email"
              title="Email"
            >
              <IconEmail class="size-5" />
            </a>
            <a
              href="https://github.com/qian403"
              target="_blank"
              rel="noopener noreferrer"
              class="cv-contact-link"
              aria-label="GitHub"
              title="GitHub"
            >
              <IconGithub class="size-5" />
            </a>
            <a
              href="https://t.me/qian50"
              target="_blank"
              rel="noopener noreferrer"
              class="cv-contact-link"
              aria-label="Telegram"
              title="Telegram"
            >
              <IconSend class="size-5" />
            </a>
          </nav>
        </div>

        <div
          class="order-first flex items-end justify-between gap-6 lg:order-last lg:block"
        >
          <Image
            priority
            src={portrait}
            alt="CHIEN 的個人頭像"
            class="size-24 rounded-full border border-foreground/12 object-cover sm:size-32 lg:ml-auto lg:size-40"
            widths={[128, 256, 320]}
            width={160}
            height={160}
          />
          <dl class="text-right font-mono text-xs/6 text-foreground/60 lg:mt-6">
            <div><dt class="sr-only">所在地</dt><dd>Yilan, Taiwan</dd></div>
            <div><dt class="sr-only">時區</dt><dd>GMT+8</dd></div>
            <div><dt class="sr-only">目前狀態</dt><dd>Student / Engineer</dd></div>
          </dl>
        </div>
      </header>

      <nav class="cv-classic-nav" aria-label="履歷章節">
        <a href="#web-experience-heading">經歷</a>
        <a href="#web-vulnerabilities-heading">漏洞研究</a>
        <a href="#web-projects-heading">專案</a>
        <a href="#web-background-heading">學歷</a>
        <a href="#web-community-heading">社群</a>
      </nav>

      <section
        class="cv-now-section grid gap-8 border-b border-foreground/10 py-10 sm:py-12 md:grid-cols-[10rem_minmax(0,1fr)] md:gap-12"
        aria-labelledby="web-focus-heading"
      >
        <div>
          <p class="font-mono text-xs font-semibold uppercase text-accent">
            Current focus
          </p>
          <h2
            id="web-focus-heading"
            class="mt-2 text-sm font-semibold text-foreground/65"
          >
            現在投入的領域
          </h2>
        </div>
        <dl class="cv-now-list grid gap-6 sm:grid-cols-3 sm:gap-0">
          <div
            class="border-t border-foreground/10 pt-4 sm:border-l sm:border-t-0 sm:px-6 sm:pt-0"
          >
            <dt class="font-mono text-xs font-semibold text-accent">01 / NETWORK</dt>
            <dd class="mt-2 text-sm/6 text-foreground/68">
              運營 AS215934，實作 BGP 路由與網路架構。
            </dd>
          </div>
          <div
            class="border-t border-foreground/10 pt-4 sm:border-l sm:border-t-0 sm:px-6 sm:pt-0"
          >
            <dt class="font-mono text-xs font-semibold text-accent">02 / SYSTEMS</dt>
            <dd class="mt-2 text-sm/6 text-foreground/68">
              處理 Linux、容器化服務與日常系統維運。
            </dd>
          </div>
          <div
            class="border-t border-foreground/10 pt-4 sm:border-l sm:border-t-0 sm:pl-6 sm:pt-0"
          >
            <dt class="font-mono text-xs font-semibold text-accent">03 / COMMUNITY</dt>
            <dd class="mt-2 text-sm/6 text-foreground/68">
              參與 SITCON 組織與學生技術社群。
            </dd>
          </div>
        </dl>
      </section>

      <section class="cv-web-section" aria-labelledby="web-experience-heading">
        <div class="cv-web-section-label">
          <p>01 / Experience</p>
          <h2 id="web-experience-heading">實務經驗</h2>
        </div>
        <div class="cv-web-content cv-timeline">
          {
            workExperience.map((job) => (
              <article class="cv-timeline-entry">
                <p class="cv-timeline-date font-mono text-xs font-semibold text-accent">
                  {formatDate(job.start)} - {formatDate(job.end)}
                  <span
                    class="mt-1 block text-foreground/48"
                    data-work-duration
                    data-work-start={job.start}
                    data-work-end={job.end ?? ''}
                  >
                    {formatWorkDuration(job.start, job.end)}
                  </span>
                </p>
                <div>
                  <h3 class="text-xl font-bold text-foreground">{job.title}</h3>
                  <p class="mt-1 text-sm font-semibold text-foreground/68">
                    {job.company} · {job.department}
                  </p>
                  <p class="mt-3 text-base/7 text-foreground/72">{job.summary}</p>
                  <ul class="mt-4 flex flex-wrap gap-2" aria-label="工作內容">
                    {job.focus.map((focus) => (
                      <li class="cv-chip">{focus}</li>
                    ))}
                  </ul>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section class="cv-web-section" aria-labelledby="web-vulnerabilities-heading">
        <div class="cv-web-section-label">
          <p>02 / Security Research</p>
          <h2 id="web-vulnerabilities-heading">漏洞研究與通報</h2>
        </div>
        <div class="cv-web-content cv-vulnerability-timeline">
          {
            vulnerabilityDisclosures.map((vulnerability) => (
              <a
                href={vulnerability.href}
                target="_blank"
                rel="noopener noreferrer"
                class="cv-vulnerability-row group no-underline"
              >
                <span>
                  <strong class="block font-mono text-sm font-bold text-accent">
                    {vulnerability.id}
                  </strong>
                  <span class="mt-2 block font-mono text-xs text-foreground/48">
                    {vulnerability.year} · {vulnerability.risk}
                  </span>
                </span>
                <span>
                  <strong class="block text-base font-bold text-foreground group-hover:text-accent">
                    {vulnerability.organization}
                  </strong>
                  <span class="mt-2 block text-sm/6 text-foreground/68">
                    {vulnerability.title}
                  </span>
                </span>
                <span>
                  <span class="block text-sm/6 text-foreground/68">
                    {vulnerability.description}
                  </span>
                  <span class="mt-2 block font-mono text-xs/5 text-foreground/48">
                    {vulnerability.type}
                  </span>
                </span>
                <span class="text-sm font-semibold text-accent">ZeroDay ↗</span>
              </a>
            ))
          }
        </div>
      </section>

      <section class="cv-web-section" aria-labelledby="web-projects-heading">
        <div class="cv-web-section-label">
          <p>03 / Projects</p>
          <h2 id="web-projects-heading">代表專案</h2>
        </div>
        <div class="cv-web-content cv-project-list divide-y divide-foreground/10">
          {
            projects.map((project, index) => (
              <a
                href={project.href}
                target="_blank"
                rel="noopener noreferrer"
                class="cv-project-row group grid gap-4 py-6 no-underline sm:grid-cols-[2.5rem_minmax(10rem,0.72fr)_minmax(0,1fr)_auto] sm:items-start"
              >
                <span class="font-mono text-xs text-foreground/42">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <span>
                  <strong class="block text-base font-bold text-foreground group-hover:text-accent">
                    {project.name}
                  </strong>
                  <span class="mt-2 block font-mono text-xs/5 text-foreground/48">
                    {project.stack}
                  </span>
                </span>
                <span class="text-sm/6 text-foreground/68">{project.description}</span>
                <span class="text-sm font-semibold text-accent">
                  {project.linkLabel} ↗
                </span>
              </a>
            ))
          }
        </div>
      </section>

      <section class="cv-web-section" aria-labelledby="web-background-heading">
        <div class="cv-web-section-label">
          <p>04 / Background</p>
          <h2 id="web-background-heading">學歷與證照</h2>
        </div>
        <div class="cv-web-content grid gap-10 lg:grid-cols-2 lg:gap-14">
          <div>
            <h3 class="cv-web-subheading">Education</h3>
            <div class="cv-compact-timeline mt-5">
              {
                education.map((item) => (
                  <div class="grid grid-cols-[minmax(0,1fr)_auto] gap-5 border-t border-foreground/10 pt-4">
                    <div>
                      <p class="font-bold text-foreground">{item.school}</p>
                      <p class="mt-1 text-sm text-foreground/62">{item.department}</p>
                    </div>
                    <p class="font-mono text-xs text-foreground/50">
                      {formatDate(item.start)} - {formatDate(item.end)}
                    </p>
                  </div>
                ))
              }
            </div>
          </div>
          <div>
            <h3 class="cv-web-subheading">Certifications</h3>
            <div class="mt-5 space-y-6">
              {
                certifications.map((certification) => (
                  <div class="grid grid-cols-[minmax(0,1fr)_auto] gap-5 border-t border-foreground/10 pt-4">
                    <div>
                      <p class="font-bold text-foreground">{certification.name}</p>
                      <p class="mt-1 text-sm/6 text-foreground/62">
                        {certification.level && `${certification.level} · `}
                        {certification.issuer}
                      </p>
                    </div>
                    <p class="font-mono text-xs font-semibold text-accent">
                      {certification.year}
                    </p>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <section class="cv-web-section" aria-labelledby="web-skills-heading">
        <div class="cv-web-section-label">
          <p>05 / Toolbox</p>
          <h2 id="web-skills-heading">技能與工具</h2>
        </div>
        <dl class="cv-web-content cv-skill-list grid gap-x-10 gap-y-7 sm:grid-cols-2">
          {
            skillGroups.map((group) => (
              <div class="border-t border-foreground/10 pt-4">
                <dt class="font-mono text-xs font-semibold uppercase text-accent">
                  {group.name}
                </dt>
                <dd class="mt-3 text-sm/7 text-foreground/72">
                  {group.skills.join(' · ')}
                </dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section class="cv-web-section" aria-labelledby="web-community-heading">
        <div class="cv-web-section-label">
          <p>06 / Community</p>
          <h2 id="web-community-heading">社群與活動</h2>
        </div>
        <div class="cv-web-content grid gap-10 lg:grid-cols-2 lg:gap-14">
          <div>
            <h3 class="cv-web-subheading">Community</h3>
            <ul class="cv-compact-timeline mt-5">
              {
                leadership.map((item) => (
                  <li class="grid grid-cols-[minmax(0,1fr)_auto] gap-5 py-4">
                    <span class="text-sm/6 text-foreground/72">
                      <>
                        <a
                          href={item.href}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="group no-underline"
                        >
                          <strong class="font-semibold text-foreground group-hover:text-accent">
                            {item.name}
                          </strong>
                        </a>
                        <span class="mt-0.5 block text-foreground/52">{item.role}</span>
                      </>
                    </span>
                    <time class="font-mono text-xs text-foreground/50">{item.year}</time>
                  </li>
                ))
              }
            </ul>
          </div>
          <div>
            <h3 class="cv-web-subheading">Training & Activities</h3>
            <ul class="cv-compact-timeline mt-5">
              {
                additionalExperience.map((item) => (
                  <li class="grid grid-cols-[minmax(0,1fr)_auto] gap-5 py-4">
                    <span class="text-sm/6 text-foreground/72">
                      <>
                        <strong class="font-semibold text-foreground">{item.name}</strong>
                        <span class="mt-0.5 block text-foreground/52">{item.role}</span>
                      </>
                    </span>
                    <time class="font-mono text-xs text-foreground/50">{item.year}</time>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </section>
    </article>

    <article
      class="cv-paper cv-print-view"
      data-cv-view-panel="print"
      aria-hidden="true"
      inert
    >
      <header class="cv-header border-b border-[#d4d4d8] pb-4">
        <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
          <div>
            <h1 class="text-[2rem] font-bold leading-none text-[#111827]">徐嘉謙</h1>
            <p class="mt-2 text-lg font-semibold text-[#2563eb]">CHIEN</p>
            <p class="mt-3 text-[0.6875rem] font-semibold uppercase text-[#4b5563]">
              Network / Security / Systems Engineer
            </p>
          </div>

          <address class="not-italic text-[0.6875rem]/5 text-[#374151] sm:text-right">
            <p>Yilan, Taiwan · GMT+8</p>
            <p><a href="mailto:hi@chien.dev">hi@chien.dev</a></p>
